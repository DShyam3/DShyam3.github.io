# Vite mode `localstack`: point the app at the local Supabase stack instead of
# production, so an automated smoke test can sign in and open the finance page
# without the real ledger.
#
# Loaded by `npm run dev:test`, which also generates `.env.localstack.local`
# holding the stack's publishable key (see scripts/localstack-env.mjs).
#
# Nothing secret is in here. The URL is a loopback address, and the account it
# names exists only on a database created by `supabase db reset`.
#
#   supabase start
#   supabase db reset     # migrations, then supabase/seed.sql
#   npm run dev:test
#
# Then sign in at /auth with the password in supabase/seed.sql.

VITE_SUPABASE_URL=http://localhost:54321

# The address the single password box signs in as. Administrator rights are
# decided by public.admin_users, not by this value.
VITE_ADMIN_EMAIL=agent@localhost.test

VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
