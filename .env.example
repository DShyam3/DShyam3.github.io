# Public Supabase project settings. The publishable key is safe to expose only
# because database policies enforce authorization.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Public image CDN base; this is not the TMDB API key.
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# The address the single password box signs in as. This is a login convenience,
# not a permission: administrator rights are granted by a row in
# public.admin_users and enforced by public.is_admin(). Changing this value
# changes which account the password is tried against, and nothing else.
#
# To run against the local stack instead, use `npm run dev:test`, which reads
# .env.localstack and points this at the seeded test account.
VITE_ADMIN_EMAIL=you@example.com
