    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:functions": "deno check supabase/functions/**/*.ts",
    "test:functions": "deno test supabase/functions/_shared/ supabase/functions/watchlist-cron-sync/ supabase/functions/links-check/"
  },
